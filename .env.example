# ──────────────────────────────────────────────────────────────────────────
# OXWAY configuration. Copy to .env (local) or set in your host's environment
# settings (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. .env is git-ignored.
# ──────────────────────────────────────────────────────────────────────────

# Deployment tier: development | staging | production
APP_ENV=development

# PostgreSQL connection string. Use a separate database per environment.
# Local (docker compose up -d):
DATABASE_URL=postgresql://oxway:oxway_dev_pw@127.0.0.1:5432/oxway_dev

# Canonical public origin (no trailing slash). Used for CSRF origin checks,
# sitemap.xml and robots.txt. Required in staging/production.
APP_ORIGIN=http://localhost:3000

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Sessions
SESSION_IDLE_MINUTES=240      # sign out after this much inactivity
SESSION_ABSOLUTE_HOURS=12     # hard session lifetime

# Login brute-force protection
LOGIN_MAX_FAILURES=5          # failures before the account is locked
LOGIN_LOCKOUT_MINUTES=15

# true behind Vercel / a reverse proxy that sets X-Forwarded-For.
# Set false if the app is exposed directly to the internet.
TRUST_PROXY=true

# Only used by `npm run db:seed` to create the FIRST administrator.
# The password must be 12+ characters. Remove these after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
